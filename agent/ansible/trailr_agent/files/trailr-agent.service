[Unit]
Description=Trailr-Agent: Benutzeraktionen an den Trailr-Server
After=network-online.target auditd.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/trailr/agent.env
ExecStart=/usr/local/bin/trailr-agent
Restart=always
RestartSec=5
# Eigener Benutzer statt root. Das Journal liest er über die Gruppe
# systemd-journal, das auditd-Protokoll (nur root lesbar) über
# CAP_DAC_READ_SEARCH: lesen ja, schreiben oder sonst etwas nein.
User=trailr
Group=trailr
SupplementaryGroups=systemd-journal
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
StateDirectory=trailr
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/trailr

[Install]
WantedBy=multi-user.target
