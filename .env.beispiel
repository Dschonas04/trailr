# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repository.
DB_KENNWORT=
# Schlüssel, mit dem die Agenten liefern (mindestens 24 Zeichen): openssl rand -hex 32
TRAILR_AGENT_SCHLUESSEL=
# Wie lange Ereignisse bleiben (Tage, 0 = für immer)
TRAILR_AUFBEWAHRUNG_TAGE=365
# Alarme stehen immer in der Oberfläche. Nach draußen gehen sie erst hiermit:
# TRAILR_TELEGRAM_TOKEN=
# TRAILR_TELEGRAM_CHAT=
# TRAILR_SMTP=smtp.example.org:587
# TRAILR_SMTP_NUTZER=
# TRAILR_SMTP_KENNWORT=
# TRAILR_ABSENDER=
# TRAILR_ALARM_AN=
# sudo und su außerhalb dieser Stunden melden:
# TRAILR_ARBEITSZEIT=7-20
# mTLS für Lieferungen. Gesetzt, nimmt NUR dieser Port welche an, und er muss
# in docker-compose freigegeben sein:
# TRAILR_MTLS_PORT=8443
# TRAILR_MTLS_ZERTIFIKAT=
# TRAILR_MTLS_SCHLUESSELDATEI=
# TRAILR_MTLS_CA=
# Notausgang, falls man sich ausgesperrt hat:
# TRAILR_SSO_AUS=1
# Wer verwaltet, zusätzlich zum ersten Konto aus der Einrichtung. Bei SSO nötig:
# TRAILR_ADMIN=oidc:https://anbieter.example/realms/name|<sub>
